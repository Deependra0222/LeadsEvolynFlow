# MongoDB Atlas connection string (free M0 cluster). Leave empty locally to use .data/local-store.json
MONGODB_URI=
# The admin password you choose for importing, editing and deleting leads
LEAD_ADMIN_PASSWORD=
# Optional: random string (32+ characters) used to sign admin sessions
LEAD_SESSION_SECRET=
# Optional: database and collection names (defaults shown)
MONGODB_DB=leadsevolynflow
MONGODB_COLLECTION=lead_store
# Optional: set to false to start with no sample leads on first run
SEED_INITIAL_LEADS=true
